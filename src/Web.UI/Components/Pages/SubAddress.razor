
<MudListItem T="Address" Value="@AddressSelection" OnClick="@ToggleExpand">
    <MudStack Row>
        <MudText>Sub Addresses</MudText>
        <MudSpacer />
        <MudIcon Icon="@(_expandSub ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
    </MudStack>    
    <MudCollapse @onclick="@(async () => await Parent.ListItemOnClickAsync(AddressSelection))" Expanded="@(_expandSub)">
        <MudList T="Address"
        Class="mud-nested-list"
        SelectionMode="SelectionMode.SingleSelection"
        Padding="false"
        Dense="@Parent.refMA.Dense">
            @if (Parent.subAddresses.Count > 0)
            {
                @foreach (var sub in Parent.subAddresses)
                {
                    <MudListItem T="Address" Value="@sub" OnClick="@(async () => await Parent.ListItemOnClickAsync(sub))" OnClickPreventDefault="true" Class="@Parent.GetListItemClassname(sub.Equals(Parent.AddressSearch))">
                        <MudText>@AddressSelection.address</MudText>
                    </MudListItem>
                }
            }
        </MudList>
    </MudCollapse>
</MudListItem>

@code {

    [Parameter]
    public TestPages Parent { get; set; } = default!;

    [Parameter]
    public Address AddressSelection { get; set; } = default!;

    private bool _expandSub = false;

    private async Task ToggleExpand()
    {
        await Parent.ListItemOnClickAsync(AddressSelection);
        _expandSub = !_expandSub;
    }
}
