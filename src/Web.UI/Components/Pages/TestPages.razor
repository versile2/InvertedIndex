@page "/MudTry2"
@inject ISnackbar SnackbarService

<MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@OnClick">Show a RenderFragment snackbar</MudButton>
@code {
    private Snackbar? _snackbar;

    private void OnClick()
    {
        SnackbarService.Clear();
        SnackbarService.Configuration.PositionClass = Defaults.Classes.Position.BottomCenter;
        _snackbar = SnackbarService.Add
    (
    @<TestComponent OnClose="CloseSnackbar" />     
        , Severity.Normal, config => {
            config.RequireInteraction = true;
            config.ShowCloseIcon = false;
            config.HideIcon = true;
        });
    }

    private void CloseSnackbar()
    {
        if (_snackbar != null)
        {
            SnackbarService.Remove(_snackbar);
            _snackbar = default;
        }
    }
}
