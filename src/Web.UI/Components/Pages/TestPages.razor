@page "/MudTry"

<MudContainer Class="pt-8">
    <MudGrid>
        <MudItem xs=12>
            <MudAutocomplete @ref="@refMA" T="Address" Label="Search for Address (AutoComplete)"
            ShowProgressIndicator="true" ProgressIndicatorColor="Color.Tertiary" ListItemClass="hide-item"
            @bind-Value="AddressSearch" SearchFunc="Search" ToStringFunc="@(e=> e==null?null : $"{e.address}")"
            ResetValueOnEmptyText="true" CoerceText="true" CoerceValue="true"
            Variant="Variant.Outlined" Clearable>
                <BeforeItemsTemplate>
                    @foreach (var e in searchedAddresses)
                    {
                        <MudListItem T="Address" Value="@e" OnClick="@(async () => await ListItemOnClickAsync(e))" OnClickPreventDefault="true" Class="@GetListItemClassname(e.Equals(AddressSearch))">
                            <MudStack AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Row>
                                <MudText>@e.address</MudText>
                                @if (e.entries > 1)
                                {
                                    <MudButton Color="Color.Tertiary" Variant="Variant.Text" EndIcon="@Icons.Material.Filled.ArrowForward">
                                        @($"+{e.entries} Entries")
                                    </MudButton>
                                }
                            </MudStack>
                            <!-- Logic here to only show linked subAddresses -->
                            @if (e.entries > 1)
                            {
                                <SubAddress Parent="@this" AddressSelection="@e" />                              
                            }
                        </MudListItem>
                    }
                </BeforeItemsTemplate>
                <ItemTemplate>
                </ItemTemplate>
            </MudAutocomplete>
        </MudItem>
    </MudGrid>
</MudContainer>

<style>
    .hide-item {
    display: none;
    visibility: collapse;
    }
</style>

@code {
    public MudAutocomplete<Address> refMA { get; set; } = default!;
    public Address AddressSearch { get; set; } = default!;
    private List<Address> searchedAddresses { get; set; } = [];
    public List<Address> subAddresses { get; set; } = [];
    private string searchValue = string.Empty;

    private async Task<IEnumerable<Address>> Search(string value, System.Threading.CancellationToken token)
    {
        searchValue = value;
        // if text is null or empty, show empty list
        if (string.IsNullOrEmpty(value)) return new List<Address>();

        // simulate loading
        await Task.Delay(1000);

        // actual search logic here
        searchedAddresses = GetAddresses.Where(a => (
                    a.street_line.Contains(searchValue, StringComparison.OrdinalIgnoreCase) ||
                    a.city.Contains(searchValue, StringComparison.OrdinalIgnoreCase) ||
                    a.state.Contains(searchValue, StringComparison.OrdinalIgnoreCase) ||
                    a.zipcode.Contains(searchValue, StringComparison.OrdinalIgnoreCase)
                )).ToList();

        if (AddressSearch?.entries > 1)
        {
            subAddresses = AptAddresses.Where(a => (
                    a.street_line.Contains(AddressSearch?.street_line ?? "!!!") ||
                    a.street_line.Contains(searchValue, StringComparison.OrdinalIgnoreCase) ||
                    a.city.Contains(searchValue, StringComparison.OrdinalIgnoreCase) ||
                    a.state.Contains(searchValue, StringComparison.OrdinalIgnoreCase) ||
                    a.zipcode.Contains(searchValue, StringComparison.OrdinalIgnoreCase)
                )).ToList();
        }
        return searchedAddresses;
    }

    public async Task ListItemOnClickAsync(Address item)
    {
        if (item == AddressSearch) return;
        AddressSearch = item;
        // they clicked an item with no extra entries (1 or 0 or null)
        if ((AddressSearch?.entries ?? 0) < 2)
        {
            searchedAddresses = [];
            subAddresses = [];
            await refMA.SelectOptionAsync(AddressSearch);
        }
        else
        {
            await refMA.OpenMenuAsync(); // trigger search
            // will need some logic to handle the link, simple example just shows subaddresses for all searched addresses with more than one entry
        }        
    }

    public string GetListItemClassname(bool isSelected)
    {
        var classes = isSelected ? "mud-selected-item mud-primary-text mud-primary-hover" : string.Empty;
        return classes;
    }

    // Keep Dropdown Menu Open if Address has Multiple Entries
    private async void HandleOpenChanged(bool isOpen)
    {
        // If Dropdown menu is closed and the selected address has multiple entires, open the menu
        Console.WriteLine($"1Entries: {(AddressSearch?.entries ?? 0)}");
        if (!isOpen && (AddressSearch?.entries ?? 0) > 1)
        {
            await refMA.ToggleMenuAsync();
            Console.WriteLine($"2Entries: {(AddressSearch?.entries ?? 0)}");
        }
    }

