<MudPopover Open="@_LogOpen" AnchorOrigin="Origin.TopCenter" TransformOrigin="Origin.BottomCenter"
            OverflowBehavior="OverflowBehavior.FlipAlways" RelativeWidth="DropdownWidth.Relative">
    <MudPaper Class="d-flex flex-column pa-2 mud-theme-info" Style="height: 300px;">
        <MudText>Content of the popover can be anything.</MudText>
        <br />
        <MudText>Click anywhere outside to close.</MudText>
    </MudPaper>
</MudPopover>
<MudStack Row="true" Wrap="Wrap.NoWrap">
    <MudText Align="Align.Center" GutterBottom="false" Typo="Typo.subtitle1">Attention, you have not saved the changes...</MudText>
    <MudButton @ref="button1" OnClick="OnClose" Variant="Variant.Outlined" Color="Color.Warning">Reset changes</MudButton>
    <MudButton OnClick="Save" Variant="Variant.Filled" Style="min-width: 110px;" Color="Color.Success">@(_LogOpen ? "Save changes" : "Show Log") </MudButton>
    <MudOverlay Visible="@_LogOpen" AutoClose OnClosed="@(() => _LogOpen = false)" />
</MudStack>
<MudOverlay Visible="true" AutoClose OnClosed="OnClose" LockScroll="true" />

@code
{
    [Parameter]
    public EventCallback OnClose { get; set; }

    private MudButton? button1;

    private bool _open = false;
    private bool _LogOpen = false;

    private void ToggleLog() => _LogOpen = !_LogOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && button1 != null)
            await button1.FocusAsync();
    }

    private async Task Save()
    {
        if (_LogOpen)
        {
            await OnClose.InvokeAsync();            
        }
        else
        {
            ToggleLog();
        }
    }
}
